{
  "name": "gp-site-finder-cloudflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "wrangler dev --ip 0.0.0.0 --port 8787",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test && wrangler deploy --dry-run --outdir .worker-build",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run build && wrangler deploy",
    "deploy:ci": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "setup": "node scripts/deploy.mjs",
    "preview:portable": "node scripts/preview.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "lucide-react": "0.575.0",
    "exceljs": "4.4.0"
  },
  "devDependencies": {
    "vite": "8.3.1",
    "wrangler": "4.141.0",
    "esbuild": "0.28.2",
    "miniflare": "5.20260925.0-alpha"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
